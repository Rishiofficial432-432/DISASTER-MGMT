# ── required ──────────────────────────────────────────────────────────────────
# Set to a random secret string to enable API key auth.
# Leave empty only for local-dev (auth is disabled when unset).
# docker-compose REQUIRES this to be set before production deploy.
CROWD_API_KEY=

# ── deployment ────────────────────────────────────────────────────────────────
DOMAIN=localhost

# ── rate limiting & upload size ───────────────────────────────────────────────
# Requests per minute per IP (backend enforces this)
RATE_LIMIT_RPM=60
# Max file upload size in MB
MAX_FILE_MB=100

# ── backend URLs (used by frontend / caddy) ───────────────────────────────────
CROWD_API_BASE_URL=http://backend:8000
CORS_ALLOW_ORIGINS=http://localhost:8501,http://frontend:8501,http://caddy:8501
TRUSTED_HOSTS=localhost,frontend,backend,caddy
HOST=0.0.0.0
PORT=8000

# ── optional: postgres ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/crowd_safety

# ── optional: email alerts ────────────────────────────────────────────────────
ALERT_EMAIL_USER=
ALERT_EMAIL_PASS=
ALERT_EMAIL_RECIPIENT=

# ── optional: twilio sms alerts ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
TWILIO_PHONE_TO=

# ── single-container / HF Spaces mode ────────────────────────────────────────
AUTO_START_BACKEND=0
